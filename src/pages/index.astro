---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((project) => project.slug !== 'orion-wealthtech')
  .sort((a, b) => a.data.order - b.data.order);

---

<Layout
  title="Azzum Naeem | Brand-to-Product Design Partner"
  description="Brand-to-product design partner for agencies and funded startups: design system, website and product UI, with files engineers can build from."
  ogImage="/images/main-image.png"
  bodyClass="body"
  isHome={true}
>
  <section class="hero-7">
    <div class="container hero">
      <div class="hero-grid top" data-reveal="blur">
        <div class="body-regular"><span class="label-final">Brand-to-Product Design Partner</span><br /></div>
        <div class="h5-regular">I take brands from guidelines to shipped product.</div>
        <div class="body-regular">When your team needs to bridge the gap between high-level brand strategy, complex product UI, and engineering-ready execution, without adding management overhead, I plug straight into your workflow.</div>
        <div class="hero-actions">
          <a href="https://calendly.com/auz-naeem/introduction-meeting" target="_blank" rel="noopener" class="navbar-label home w-button">Book a call ↗</a>
          <button type="button" class="nav-email hero-email" data-copy-email="hello@azzum.studio" aria-label="Copy email address hello@azzum.studio" title="Copy email">
            <span class="navbar-label">hello@azzum.studio</span>
            <svg class="nav-email-icon nav-copy-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <svg class="nav-email-icon nav-copy-done" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span class="nav-copy-status" role="status" aria-live="polite"></span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="section-2">
    <div class="container-projects">
      <div class="div-block-19">
        <h1 class="h6-regular">Featured case studies<span class="label-final">[0{projects.length}]</span></h1>
        <div class="w-layout-grid collection-list-2">
          {projects.map((project) => (
            <a
              href={`/${project.slug}.html`}
              class="project-link w-inline-block"
              id={project.slug === 'paymaster' ? 'w-node-d075961b-f955-74f9-366b-ced34e295fe3-299bdac1' : undefined}
            >
              {project.data.homeMedia.type === 'image' ? (
                <img
                  src={project.data.homeMedia.src}
                  srcset={project.data.homeMedia.srcset}
                  sizes="(max-width: 479px) 48vw, (max-width: 1439px) 49vw, 50vw"
                  loading="lazy"
                  alt=""
                  class="project-image home on"
                  data-reveal="blur"
                />
              ) : (
                <div
                  data-poster-url={project.data.homeMedia.poster}
                  data-video-urls={`${project.data.homeMedia.mp4},${project.data.homeMedia.webm}`}
                  data-autoplay="true"
                  data-loop="true"
                  data-reveal="blur"
                  class="vid homevid w-background-video w-background-video-atom"
                >
                  <video
                    autoplay
                    loop
                    muted
                    playsinline
                    style={`background-image:url("${project.data.homeMedia.poster}")`}
                    data-object-fit="cover"
                  >
                    <source src={project.data.homeMedia.mp4} />
                    <source src={project.data.homeMedia.webm} />
                  </video>
                </div>
              )}
              <div class="project-meta">
                <p class="label-final">{project.data.homeLabel}</p>
                {project.data.tags?.length && <p class="label-final tag-line">{project.data.tags.join(' • ')}</p>}
              </div>
              <p class="body-large">{project.data.homeDescription}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="hero-7 btm">
    <div class="container experiences">
      <div data-reveal="blur" class="hero-grid">
        <h1 class="h6-regular capabilities-title">Built to Eliminate Agency Handoff Friction</h1>
        <div class="body-large capabilities-intro">You should not have to choose between stunning brand aesthetics and clean engineering execution. I own the entire continuum.</div>
        <div class="capabilities-columns">
          <div class="div-block-24 capablilites">
            <div class="label-final tag-line">Brand-to-Digital Integrity</div>
            <div class="label-final">Zero Translation Loss</div>
            <div class="body-large">I translate static brand expressions into dynamic, responsive digital environments that maintain design intent across every screen and device.</div>
          </div>
          <div class="div-block-24 capablilites">
            <div class="label-final tag-line">Complex Product &amp; UI Depth</div>
            <div class="label-final">Interfaces That Make Sense</div>
            <div class="body-large">Designing intuitive web applications, dashboards, and digital products that make complex user workflows feel effortless.</div>
          </div>
          <div class="div-block-24 capablilites">
            <div class="label-final tag-line">Design Engineering &amp; Systems</div>
            <div class="label-final">Build-Ready Figma Files</div>
            <div class="body-large">No messy layers or broken constraints. You get rigorous design tokens, clean component sets, and systems your developers can actually code straight from.</div>
          </div>
        </div>
      </div>
      <div data-reveal="blur" class="hero-grid">
        <h1 class="h6-regular">What People Say</h1>
        <div class="tcarousel" data-carousel role="region" aria-roledescription="carousel" aria-label="Testimonials">
          <div class="tcarousel-viewport" tabindex="0">
            <div class="tcarousel-track">
            <article class="tcarousel-slide div-block-24 testimonial" aria-roledescription="slide" aria-label="1 of 3">
              <div class="body-large">&quot;My agency needed a Ul/UX designer on a tight turnaround. Azzum accepted this assignment from us and was invaluable in helping to fulfill our client&#x27;s request. He was able to learn a new brand system extremely quickly, and successfully collaborated with our creative team.<br />‍<br />As a project manager, I was also appreciative of his responsiveness and high level of engagement on the work - it&#x27;s fantastic when freelance designers take a real stake in the project&#x27;s success, and Azzum was highly invested from start to finish. I&#x27;d highly recommend him for his talent, work ethic, and demeanor that he brings to a team!&quot;</div>
              <div class="testimonial-author">
              <img src="/images/headshot-tyler.png" alt="Tyler Reilly" width="48" height="48" loading="eager" class="testimonial-headshot" />
              <div class="testimonial-meta">
                <div class="label-final">tyler reilly</div>
                <div class="label-final testimonial-role">project manager | Fifty thousand feet</div>
              </div>
            </div>
            </article>
            <article class="tcarousel-slide div-block-24 testimonial" aria-roledescription="slide" aria-label="2 of 3">
              <div class="body-large">&quot;Azzum is one of the most talented and well-rounded UX designers I&#x27;ve had the privilege of working with. What sets him apart is his wide-ranging design experience, which allows him to tackle a diverse array of design challenges with confidence. Whether it was building intuitive user interfaces or creating visually stunning graphic elements, Azzum consistently delivered outstanding results.&quot;</div>
              <div class="testimonial-author">
              <img src="/images/headshot-michael.png" alt="Michael Finn" width="48" height="48" loading="eager" class="testimonial-headshot" />
              <div class="testimonial-meta">
                <div class="label-final">Michael finn</div>
                <div class="label-final testimonial-role">Account director | 20nine</div>
              </div>
            </div>
            </article>
            <article class="tcarousel-slide div-block-24 testimonial" aria-roledescription="slide" aria-label="3 of 3">
              <div class="body-large">&quot;We selected him from a large pool of candidates, chosen for his talented design skills, strategic abilities and his collaborative personality. He was a great addition to our tight group and added to the creative vibe of our agency.&quot;<br /></div>
              <div class="testimonial-author">
              <img src="/images/headshot-thomas.png" alt="Thomas Cook" width="48" height="48" loading="eager" class="testimonial-headshot" />
              <div class="testimonial-meta">
                <div class="label-final">thomas cook</div>
                <div class="label-final testimonial-role">creative director | Bear in the hall</div>
              </div>
            </div>
            </article>
            </div>
          </div>
          <div class="tcarousel-controls">
            <button type="button" class="tcarousel-btn" data-carousel-prev aria-label="Previous testimonial"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg></button>
            <span class="tcarousel-count" aria-live="polite"><span data-carousel-current>1</span> / 3</span>
            <button type="button" class="tcarousel-btn" data-carousel-next aria-label="Next testimonial"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="hero-7 btm abt">
    <div class="container experiences about-me">
      <div data-reveal="blur" class="hero-grid">
        <h1 class="h6-regular capabilities-title">Flexible Collaboration</h1>
        <div class="body-large capabilities-intro">Tailored to fit active agency project timelines, design system sprints, or capacity gaps.</div>
        <div class="engagement-cards">
          <div class="engagement-card">
            <div class="label-final">The Paid Trial Pilot Sprint</div>
            <div class="engagement-price">$1,500 / 1 Week</div>
            <div class="body-large">A tightly scoped sprint for a single high-impact deliverable (e.g., brand-to-web translation, UI component set, or product screen design).</div>
            <div class="engagement-guarantee">
              <div class="label-final">Zero-Risk Guarantee</div>
              <div class="body-large">If the first deliverable misses the brief, that week is unbilled.</div>
            </div>
            <a href="https://calendly.com/auz-naeem/introduction-meeting" target="_blank" rel="noopener" class="navbar-label home w-button">Book a Pilot Sprint ↗</a>
          </div>
          <div class="engagement-card">
            <div class="label-final">Reserved Capacity Retainer</div>
            <div class="engagement-price">$3,000 – $6,000+/mo</div>
            <div class="label-final tag-line">3-month minimum</div>
            <ul class="engagement-list" role="list">
              <li class="body-large">Dedicated monthly capacity (10 or 15 days/month)</li>
              <li class="body-large">Priority scheduling</li>
              <li class="body-large">2 to 3 day turnarounds</li>
              <li class="body-large">Seamless cross-functional integration</li>
            </ul>
            <a href="https://calendly.com/auz-naeem/introduction-meeting" target="_blank" rel="noopener" class="navbar-label home w-button">Check Availability ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
